PORT=3000
NODE_ENV=development

# App parameters
APP_DEFAULT_RESEARCH_THRESHOLD=0.8

# Per-session caps for Veritas Live. Credits are internal usage estimates,
# not currency and not the provider's actual billing/quota units.
LIVE_LLM_MAX_CALLS=200
LIVE_LLM_MAX_CREDITS=200
LIVE_RESEARCH_MAX_SEARCHES=60
LIVE_RESEARCH_MAX_EXTRACTS=120
LIVE_RESEARCH_MAX_CALLS=180
LIVE_RESEARCH_MAX_CREDITS=180
